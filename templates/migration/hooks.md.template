# hooks.yaml - foreshadowing/hook tracking
# Based on InkOS Hook Lifecycle + webnovel-writer Reading Power Taxonomy
# Tracks the full lifecycle of foreshadowing across chapters: pending → mentioned → resolved → abandoned

hooks:
  # Each hook has a full lifecycle state
  # id: unique identifier
  # description: hook content, in one sentence
  # introduced_in: chapter where introduced (vol-ch format)
  # status: pending | mentioned | resolved | abandoned
  # payoff_timing: immediate (within 1-3 chapters) | near_term (within 5-10 chapters) | mid_arc (within this volume) | slow_burn (across volumes) | endgame (finale)
  # priority: 1 (core main thread) | 2 (important subplot) | 3 (optional foreshadowing)
  # hook_type: mystery (suspense) | threat (threat) | promise (promise) | clue (clue) | relationship (relationship foreshadowing) | power (ability foreshadowing) | emotion (emotion hook, driven by anger/heartache/empathy) | choice (choice hook, driven by a dilemma) | desire (desire hook, driven by expectation of payoff)
  # hook_strength: strong (volume end/key turning point) | medium (ordinary chapter) | weak (transitional chapter)
  # hook_position: chapter_end (drives the reader to the next chapter from the chapter end) | in_chapter (keeps immersion within the chapter) | both
  # last_mentioned_chapter: the chapter where it was most recently mentioned
  # resolution_chapter: the chapter where it pays off (fill in when resolved/abandoned)
  # notes: extra notes
  - id: ""
    description: ""
    introduced_in: "1-1"
    status: "pending"
    payoff_timing: "near_term"
    priority: 1
    hook_type: "mystery"
    hook_strength: "medium"      # strong | medium | weak
    hook_position: "chapter_end" # chapter_end | in_chapter | both
    seed_text: ""           # The original passage (1-3 sentences) where the hook was planted, used to anchor reader memory at payoff time
    seed_location: ""       # The exact location where it was planted (vol-ch format)
    last_mentioned_chapter: ""
    resolution_chapter: ""
    notes: ""

# Hook type guide (expanded from the webnovel-writer Reading Power Taxonomy)
hook_type_guide:
  mystery:     "Suspense hook: information gap/unresolved mystery, the reader wants the answer"
  threat:      "Crisis hook: an enemy appears/danger approaches, the reader worries about the characters"
  promise:     "Promise hook: a future event is clearly previewed, the reader looks forward to the payoff"
  clue:        "Clue hook: fragmentary information/hints, the reader wants to piece together the full picture"
  relationship: "Relationship hook: tension or change in a relationship, the reader wants to see where the relationship goes"
  power:       "Ability hook: an ability breakthrough or new skill is previewed, the reader looks forward to the character growing stronger"
  emotion:     "Emotion hook: triggers anger/heartache/empathy/injustice, the reader wants to stand up for the protagonist or see justice done"
  choice:      "Choice hook: a dilemma or high-risk decision, the reader wants to know what the character will choose"
  desire:      "Desire hook: a reward/breakthrough/revenge/truth is at hand, the reader wants to see the wish fulfilled"

# Hook strength guide
hook_strength_guide:
  strong:  "Volume end/key turning point/before a major conflict: the reader must know what happens next right away"
  medium:  "Ordinary plot chapter: the reader wants to know, but can wait until the next chapter"
  weak:    "Transitional/setup chapter: just keep the reading momentum going"

# Hook health check rules (adapted from the InkOS Auditor hook health analysis)
hook_health_rules:
  # A sensible distribution of hooks of the same type across payoff windows
  payoff_distribution:
    immediate_max: 3     # At most 3 unresolved hooks in the immediate window at the same time
    near_term_max: 5     # At most 5 in the near_term window
    mid_arc_max: 8       # At most 8 in the mid_arc window
    slow_burn_max: 5     # At most 5 in the slow_burn window

  # Hook staleness check: a hook not mentioned for more than N chapters is marked stale
  stale_threshold:
    high_priority: 5     # A high-priority hook not mentioned for more than 5 chapters triggers a warning
    normal_priority: 3   # An ordinary hook not mentioned for more than 3 chapters triggers a warning

  # Disallowed hook states
  no_burst_settlement: true   # Do not resolve 3 or more hooks in a single chapter
  no_orphan_hooks: true       # Do not link an abandoned hook to an active character or main thread

  # Hook strength distribution check
  strength_distribution:
    max_consecutive_weak: 3    # At most 3 consecutive weak hooks
    require_strong_every: 5    # At least one strong hook every 5 chapters (usually at a volume end or key turning point)

# Hook operation semantics (adapted from InkOS upsert/mention/resolve/defer)
hook_operations:
  upsert: "Add or update a hook (when the same hook evolves across chapters, update its description and last_mentioned). A new hook must have 1-3 sentences of original text extracted from the main text at archive time and filled into seed_text"
  mention: "An existing hook is mentioned in this chapter; update last_mentioned_chapter"
  resolve: "The hook pays off in the current chapter; fill in resolution_chapter. At payoff time, quote the original scene from seed_text so the payoff passage echoes the scene from when it was planted"
  defer: "The hook payoff is postponed (state the reason and the new payoff expectation)"
  abandon: "Abandon the hook (only when the main thread changes direction; state the reason)"
  extract_seed: "At archive time, extract the original passage (1-3 sentences) of a newly planted hook from the main text and fill it into that hook's seed_text field"
